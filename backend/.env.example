# AgroSmart — Environment Variable Template
# Copy this file to .env and fill in your values.
# NEVER commit the actual .env file to version control.

# ── Flask ──────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ───────────────────────────────────────────────────────────────────
# SQLite path relative to backend/instance/
DATABASE_URL=sqlite:///agrosmart.db

# ── Sensor mode ────────────────────────────────────────────────────────────────
# "simulator"  → use SimulatedSensor (development / no hardware)
# "hardware"   → use RaspberryPiSensor (requires GPIO + Pi hardware)
SENSOR_MODE=simulator

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=5000

# ── File uploads ───────────────────────────────────────────────────────────────
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH=10485760   # 10 MB in bytes

# ── ML model paths (relative to backend/) ─────────────────────────────────────
CROP_MODEL_PATH=trained_models/crop_rf_v1.pkl
SOIL_CNN_MODEL_PATH=trained_models/soil_cnn_v1.h5
# Fertilizer: prototype (Kaggle) until replaced by AgroSmart final model
FERTILIZER_MODEL_PATH=trained_models/fertilizer_dt_prototype.pkl
FERTILIZER_MODEL_LABEL=prototype_kaggle_v1.0
FEATURE_SCALER_PATH=trained_models/feature_scaler.pkl
LABEL_ENCODERS_PATH=trained_models/label_encoders.pkl
